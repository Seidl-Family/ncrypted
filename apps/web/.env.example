# Base wallet that receives USDC payments (required)
NCRYPTED_PAY_TO=0x...
# eip155:84532 = Base Sepolia (testnet), eip155:8453 = Base mainnet
NCRYPTED_NETWORK=eip155:84532
NCRYPTED_PRICE=$0.005
# Public origin used in share links
NCRYPTED_PUBLIC_URL=http://localhost:3000
# Coinbase CDP facilitator (mainnet + Bazaar). Without these, the free x402.org testnet facilitator is used.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Upstash Redis (provisioned via Vercel Marketplace). Without these in dev, an in-memory store is used.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Resend for email delivery
RESEND_API_KEY=
EMAIL_FROM=ncrypted <secrets@ncrypted.ai>
